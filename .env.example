# Environment Variables Example for Smart Lab Portal

# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smart_lab_db
DB_USER=postgres
DB_PASSWORD=postgres

# Authentication Configuration
JWT_SECRET=super_secret_jwt_key_pes_smart_lab_2026_change_in_production
JWT_EXPIRES_IN=15m

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
